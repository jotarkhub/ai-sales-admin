# File ini otomatis dipakai Laravel saat APP_ENV=testing (di-force oleh phpunit.xml).
# Tujuan: test lokal cepat pakai SQLite in-memory, tanpa perlu database MySQL terpisah.
# Tidak berisi rahasia apa pun -> aman untuk di-commit ke repository.
#
# CI (GitHub Actions) TIDAK memakai file ini untuk koneksi database: workflow men-set
# DB_CONNECTION=mysql dkk. sebagai environment variable di level job, dan nilai environment
# variable proses selalu menang atas isi file .env.testing (Dotenv Laravel bersifat immutable).
# Jadi: test lokal -> SQLite (cepat), test CI -> MySQL asli (mendekati produksi).

APP_ENV=testing
APP_KEY=base64:brfjseN15i4j1j1tezkT4hVfXNTheKN+Oq0mXyuybgw=
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BCRYPT_ROUNDS=4
